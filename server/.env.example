# Chave do Ollama Cloud (https://ollama.com) — necessária para usar IA na explicação.
# Se ficar vazia, o servidor cai automaticamente na heurística local (sem IA).
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# Token pessoal do GitHub (opcional) — sem escopos, só para elevar o limite
# de requisições anônimas (60/hora) para 5000/hora. Gere em
# https://github.com/settings/tokens com o tipo "fine-grained" sem nenhuma permissão.
GITHUB_TOKEN=

PORT=8460
RATE_LIMIT_PER_HOUR=30
